# HarvestGuard backend environment variables (EXAMPLE - do NOT store secrets here)
# Copy this file to `.env` and fill in real values locally (never commit `.env`)

# Hugging Face token for disease detection (optional for local demo)
HF_TOKEN=hf_your_token_here

# Gemini API key for pest identification and voice assistant (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API key for weather data
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Frontend allowed origins (comma-separated)
FRONTEND_URL=http://localhost:5173,https://your-production-frontend.example.com

# Server port (optional)
PORT=3001

# NODE_ENV=development or production
NODE_ENV=development
