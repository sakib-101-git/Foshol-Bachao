# HarvestGuard frontend environment variables (EXAMPLE - do NOT store secrets here)
# Copy this file to `.env` in the `frontend` folder for local development.

# Optional: Hugging Face public token for direct client calls (only if you understand CORS and token exposure)
VITE_HF_TOKEN=hf_your_token_here

# API base URL for the frontend to call the backend
VITE_API_BASE=http://localhost:3001/api
