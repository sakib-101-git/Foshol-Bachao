{
  "buildCommand": "cd harvestguard/frontend && npm install && npm run build",
  "outputDirectory": "harvestguard/frontend/dist",
  "devCommand": "cd harvestguard/frontend && npm run dev",
  "installCommand": "cd harvestguard/frontend && npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}

